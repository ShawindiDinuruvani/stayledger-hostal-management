# Frontend development API endpoints (no secrets here)
# The group Monthly Fees Laravel app stays on port 8001.
VITE_LARAVEL_API_URL=http://localhost:8001/api

# The User Accounts & Access Laravel app runs independently on port 8002.
# Vite forwards /laravel/* requests to this backend.
VITE_USER_ACCESS_API_URL=http://127.0.0.1:8002
