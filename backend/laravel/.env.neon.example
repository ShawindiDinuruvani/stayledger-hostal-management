# Optional local Neon *development branch* configuration.
# Copy these lines into your ignored backend/laravel/.env only after the
# Neon owner provides NEW, ROTATED, least-privilege credentials privately.
# NEVER put real credentials in Git or reuse the exposed URL in backend/db.php.
#
# This is an example, not a working connection string.
APP_URL=http://127.0.0.1:8002
DB_CONNECTION=pgsql
DB_HOST=your-development-branch.neon.tech
DB_PORT=5432
DB_DATABASE=your_development_database
DB_USERNAME=your_development_username
DB_PASSWORD=replace_locally_only
DB_SSLMODE=require
# Leave DB_URL unset when using the separate DB_* fields.
#
# Separate Laravel apps do not automatically share sessions, even with
# the same PostgreSQL server. Store this app's sessions locally.
SESSION_DRIVER=file
SESSION_COOKIE=stayledger_user_access_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
